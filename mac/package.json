{
  "name": "b2-browser-mac",
  "productName": "B2 Browser",
  "version": "1.0.0",
  "description": "Native Mac shell for B2 Browser: uploads dropped files in place, with no temp copies",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir"
  },
  "build": {
    "appId": "com.aeromax.b2browser",
    "files": ["main.js", "preload.js"],
    "extraResources": [
      { "from": "../app.py", "to": "app.py" },
      { "from": "../index.html", "to": "index.html" }
    ],
    "mac": { "category": "public.app-category.utilities", "identity": null }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
